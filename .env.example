# ============================================================================
# Exemplu de configurare. Copiază în `.env` și completează valorile reale.
# `.env` NU se comite niciodată în git.
# ============================================================================

# --- PostgreSQL ---
POSTGRES_USER=libraria
# Generează o parolă puternică: openssl rand -base64 24
POSTGRES_PASSWORD=schimba-ma
POSTGRES_DB=libraria

# --- Backend / baza de date ---
PGHOST=db
PGPORT=5432
PGUSER=libraria
PGPASSWORD=schimba-ma
PGDATABASE=libraria
PORT=4000

# --- Sesiuni (JWT) ---
# Minim 32 de caractere în producție. Generează: openssl rand -hex 32
JWT_SECRET=schimba-ma-cu-un-secret-lung-de-minim-32-caractere
JWT_TTL=7d

# --- Conturi de administrare ---
# Format: email|parola|Nume;email2|parola2|Nume2 (fără spații în jurul valorilor)
# La fiecare pornire backend-ul creează conturile lipsă cu rol admin.
# Adminii se pot autentifica cu emailul SAU cu numele de utilizator (Nume).
# ADMIN_ACCOUNTS=admin@exemplu.ro|schimba-ma|Administrator;al-doilea@exemplu.ro|schimba-ma-2|AlDoilea
#
# Fallback pentru un singur cont (compatibilitate cu deploy-urile vechi):
# Dacă lași ambele seturi goale, backend-ul de producție refuză să pornească.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# 1 = forțează parolele din .env la următoarea pornire (apoi revino la 0)
ADMIN_RESET_PASSWORD=0

# --- Email (SMTP real) ---
SMTP_HOST=smtp.exemplu.ro
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=comenzi@exemplu.ro
SMTP_PASS=parola-aplicatie
MAIL_FROM=
CONTACT_TO=comenzi@exemplu.ro

# --- Site ---
# Domeniul public, folosit în linkurile din emailuri și în sitemap.
PUBLIC_URL=https://exemplu.ro
# Origini permise pentru API (producție: https://domeniul.ro). Lasă gol în dev.
CORS_ORIGINS=
# Portul public al frontend-ului. Cu Caddy/Traefik pe host folosește 8080.
FRONTEND_PORT=80

# --- SameDay EasyBox (opțional) ---
# Fără credențiale, checkout-ul folosește lista demonstrativă de lockere.
# SAMEDAY_USERNAME=
# SAMEDAY_PASSWORD=
# SAMEDAY_API=https://sameday-api.demo.zitec.com
# SAMEDAY_REMEMBER_ME=0
